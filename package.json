{
  "name": "kkomkkom",
  "version": "0.1.0",
  "description": "Pre-commit check for Next.js: find API routes open without auth and pages that got heavier",
  "type": "module",
  "bin": {
    "kkomkkom": "dist/cli.js",
    "kkomkkom-mcp": "dist/mcp.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "verify": "node scripts/verify.mjs",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "nextjs",
    "security",
    "api",
    "checkup",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hodoi-ing/kkomkkom.git"
  },
  "homepage": "https://github.com/hodoi-ing/kkomkkom#readme",
  "bugs": {
    "url": "https://github.com/hodoi-ing/kkomkkom/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
